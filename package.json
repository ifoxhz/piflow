{
  "name": "bluelamp",
  "private": true,
  "version": "0.1.0",
  "description": "Local RAG desktop app — Pleias-RAG-1B + BGE-M3",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:ui": "pnpm --filter @bluelamp/desktop dev",
    "dev:server": "pnpm --filter @bluelamp/rag-server dev",
    "dev:server:restart": "bash scripts/restart-rag-server.sh",
    "build": "pnpm -r build",
    "models:ensure": "tsx scripts/models-ensure.ts",
    "models:download": "tsx scripts/models-ensure.ts --force",
    "bundle:windows-sidecar": "node scripts/bundle-windows-sidecar.mjs",
    "package:windows-portable": "node scripts/package-windows-portable.mjs",
    "build:windows": "pnpm bundle:windows-sidecar && pnpm --filter @bluelamp/desktop exec tauri build --no-bundle && pnpm package:windows-portable"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.21.0"
    }
  }
}
