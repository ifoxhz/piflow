# BlueLamp 环境变量（复制为 .env 后按需修改）

# 国内 Hugging Face 镜像
HF_ENDPOINT=https://hf-mirror.com

# RAG HTTP 服务
BLUELAMP_RAG_PORT=3847

# 前端连接 RAG 服务（Vite 会注入 import.meta.env）
VITE_RAG_SERVER_URL=http://127.0.0.1:3847

# 模型本地目录（默认仓库内 models/）
BLUELAMP_MODELS_DIR=./models

# 用户数据目录（生产环境由 Tauri 注入；WSL 开发可省略）
# BLUELAMP_DATA_DIR=

# ── 本地 Node 生成（node-llama-cpp + Qwen2.5-3B GGUF，无需 Ollama）──
# 先下载：pnpm models:ensure -- generation.qwen2.5-3b-instruct
# BLUELAMP_USE_LOCAL_LLM=true
# BLUELAMP_LOCAL_GGUF=Qwen2.5-3B-Instruct/qwen2.5-3b-instruct-q4_k_m.gguf
# BLUELAMP_LOCAL_LLM_CONTEXT=8192
# 与远程 Ollama 同时配置时优先走本地：
# BLUELAMP_PREFER_LOCAL_LLM=true

# 远程 Ollama（推荐：3090 等 GPU 服务器）
# BLUELAMP_OLLAMA_URL=http://10.0.0.7:11434
# BLUELAMP_OLLAMA_MODEL=qwen3.5:4b
# BLUELAMP_CHAT_TIMEOUT_MS=180000
# 可选：中文单独指定模型（不设则与 OLLAMA_MODEL 相同）
# BLUELAMP_OLLAMA_MODEL_ZH=qwen3.5:4b
# 旧版 Pleias（仅英语/欧洲语 RAG，中文效果差）
# BLUELAMP_OLLAMA_MODEL=Pleias
