# piFlow 环境变量（复制为 .env 后按需修改）

# 国内 Hugging Face 镜像
HF_ENDPOINT=https://hf-mirror.com

# RAG HTTP 服务
PIFLOW_RAG_PORT=3847

# 前端连接 RAG 服务（Vite 会注入 import.meta.env）
VITE_RAG_SERVER_URL=http://127.0.0.1:3847

# 模型本地目录（默认仓库内 models/）
PIFLOW_MODELS_DIR=./models

# 用户数据目录（生产环境由 Tauri 注入；WSL 开发可省略）
# PIFLOW_DATA_DIR=

# ── 本地 Node 生成（node-llama-cpp + Qwen2.5-3B GGUF，无需 Ollama）──
# 先下载：pnpm models:ensure -- generation.qwen2.5-3b-instruct
# PIFLOW_USE_LOCAL_LLM=true
# PIFLOW_LOCAL_GGUF=Qwen2.5-3B-Instruct/qwen2.5-3b-instruct-q4_k_m.gguf
# PIFLOW_LOCAL_LLM_CONTEXT=8192
# 与远程 Ollama 同时配置时优先走本地：
# PIFLOW_PREFER_LOCAL_LLM=true

# 远程 Ollama（推荐：GPU 服务器 10.0.0.7）
# 也可在桌面 Settings → Ollama 中配置；UI 保存写入 .data/ollama-config.json 并立即生效
PIFLOW_OLLAMA_URL=http://10.0.0.7:11434
PIFLOW_OLLAMA_MODEL=qwen3.5:4b
PIFLOW_CHAT_TIMEOUT_MS=180000
# 检索规划 LLM 超时（默认 30000）
# PIFLOW_PLAN_TIMEOUT_MS=30000
# 意图模板路由最低置信度（BGE-M3 exemplar cosine，默认 0.42）
# PIFLOW_TEMPLATE_SCORE_MIN=0.42
# 可选：中文单独指定模型（不设则与 OLLAMA_MODEL 相同）
# PIFLOW_OLLAMA_MODEL_ZH=qwen3.5:4b
# 旧版 Pleias（仅英语/欧洲语 RAG，中文效果差）
# PIFLOW_OLLAMA_MODEL=Pleias

# LLM 入参 / 检索计划日志（JSONL）
# 路径：{PIFLOW_DATA_DIR}/logs/llm-queries.jsonl（默认 .data/logs/llm-queries.jsonl）

# ── 模型配置：优先用 Settings → 模型配置（写入 .data/llm-config.json）──
# Ollama / DeepSeek 互斥；API Key 不会从本文件回填到设置表单
# DEEPSEEK_API_KEY=   # 仅作服务端静默回退，可选

# ── piFlow（Pi agent + Postgres 只读 tools）──
# 也可在桌面 Settings → Postgres 中配置；UI 保存写入 .data/postgres-config.json
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/postgres
# PG_QUERY_TIMEOUT_MS=15000
# PG_MAX_ROWS=200
# SCHEMA_CACHE_TTL_MS=1800000
# SCHEMA_BRIEF_MAX_CHARS=6000
# 实验：默认关闭 schema cache（不注入 brief，tools 直查 information_schema）
# PIFLOW_SCHEMA_CACHE=false
# 需要恢复 brief 注入时设为 true
# PIFLOW_SCHEMA_CACHE=true
# Postgres skill 附带 docs 表结构 reference 的最大注入字符数（默认 28000）
# PIFLOW_SKILL_REF_MAX_CHARS=28000
#
# Local FS skill 在 Settings → Local FS 中配置（写入 .data/piflow-skills.json）
# 启用后注入 read/bash/edit/write；Windows 需安装 Git Bash
#
# 单轮 tool 软预算（UI 显示 n/budget；超预算仅观测告警，暂不硬停）
# PIFLOW_TOOL_BUDGET=10

# PDF 导入页窗口（解析→切块→embed→入库；默认 20）
# PIFLOW_INGEST_PAGE_WINDOW=20
