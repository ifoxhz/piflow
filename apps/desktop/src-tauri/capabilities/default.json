{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/com.bluelamp.rag-assistant/**" },
        { "path": "$APPDATA\\com.bluelamp.rag-assistant\\**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
