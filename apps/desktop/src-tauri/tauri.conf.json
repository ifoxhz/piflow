{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piFlow",
  "version": "0.1.0",
  "identifier": "piFlow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "piFlow",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/models/": "models/",
      "resources/rag-server.zip": "rag-server.zip",
      "resources/BUNDLE_INFO.json": "BUNDLE_INFO.json",
      "resources/seed/piflow.db": "seed/piflow.db"
    }
  }
}
